<% content_for "header" do %>
<title>Pair Lightious</title>
<% end %>

<div class="pure-g">
    <div class="pure-u-1 pure-u-lg-1-5"></div>
    <div class="pure-u-1 pure-u-lg-3-5">
        <div class="h-box">
            <h1>Pair Lightious</h1>
            <p>On the phone, open Settings → Companion → Pair this phone. Enter the eight-character code here.</p>

            <% if error_message %>
                <p><strong><%= HTML.escape(error_message.not_nil!) %></strong></p>
            <% end %>

            <% if pending_pairing %>
                <h2>Approve this phone?</h2>
                <p><strong><%= HTML.escape(pending_pairing.not_nil!.device_label) %></strong></p>
                <p>The phone will get a separate, revocable Lightious credential. It will not receive your Invidious password, browser session, or API token.</p>
                <form class="pure-form" action="/lightious/pair" method="post">
                    <input type="hidden" name="user_code" value="<%= HTML.escape(user_code) %>">
                    <input type="hidden" name="csrf_token" value="<%= HTML.escape(csrf_token) %>">
                    <button class="pure-button pure-button-primary" type="submit">Approve phone</button>
                    <a class="pure-button" href="/lightious/pair">Cancel</a>
                </form>
            <% else %>
                <form class="pure-form pure-form-stacked" action="/lightious/pair/preview" method="post">
                    <label for="user-code">Pairing code</label>
                    <input id="user-code" name="user_code" type="text" required maxlength="12" autocomplete="one-time-code" value="<%= HTML.escape(user_code) %>" placeholder="ABCD-EFGH">
                    <input type="hidden" name="csrf_token" value="<%= HTML.escape(csrf_token) %>">
                    <button class="pure-button pure-button-primary" type="submit">Continue</button>
                    <a class="pure-button" href="/lightious">Back</a>
                </form>
            <% end %>
        </div>
    </div>
    <div class="pure-u-1 pure-u-lg-1-5"></div>
</div>
