<% content_for "header" do %>
<title>Phone settings · Lightious</title>
<meta name="description" content="Choose the Lightious experience and manage the phones connected to your companion.">
<% end %>

<div class="lightious-dashboard" data-lightious-page="home">
    <aside class="lightious-intro">
        <p class="lightious-kicker">Home</p>
        <h1>Set the boundaries.</h1>
        <p class="lightious-lede">
            Choose how open Lightious feels, then control which phones are allowed to receive your library.
        </p>

        <dl class="lightious-stats" aria-label="Phone settings summary">
            <div class="lightious-stat">
                <dt>Experience</dt>
                <dd><%= profile.mode == "focused" ? "Focused" : "Explore" %></dd>
            </div>
            <div class="lightious-stat">
                <dt>Phones</dt>
                <dd><%= devices.size %> paired</dd>
            </div>
        </dl>
    </aside>

    <div class="lightious-workspace">
        <% if notice %>
            <div class="lightious-notice" role="status" aria-live="polite">
                <span class="lightious-notice-mark" aria-hidden="true">●</span>
                <span><%= HTML.escape(notice.not_nil!) %></span>
            </div>
        <% end %>

        <section class="lightious-section" id="experience" aria-labelledby="experience-title">
            <header class="lightious-section-header">
                <div>
                    <p class="lightious-section-label">Phone experience</p>
                    <h2 id="experience-title">How open should Lightious be?</h2>
                </div>
            </header>

            <form action="/lightious/mode" method="post">
                <fieldset class="lightious-choice-group">
                    <legend class="lightious-visually-hidden">Phone experience</legend>
                    <div class="lightious-mode-options">
                        <label class="lightious-mode-option">
                            <span class="lightious-mode-copy">
                                <strong>Focused</strong>
                                <span>Only the videos, channels, and playlists chosen in Library appear on the phone.</span>
                            </span>
                            <input type="radio" name="mode" value="focused" <% if profile.mode == "focused" %>checked<% end %>>
                        </label>
                        <label class="lightious-mode-option">
                            <span class="lightious-mode-copy">
                                <strong>Explore</strong>
                                <span>Allow search, feeds, and local history on the phone.</span>
                            </span>
                            <input type="radio" name="mode" value="explore" <% if profile.mode == "explore" %>checked<% end %>>
                        </label>
                    </div>
                </fieldset>
                <input type="hidden" name="csrf_token" value="<%= HTML.escape(csrf_token) %>">
                <div class="lightious-section-actions">
                    <button class="lightious-action" type="submit">Save experience</button>
                </div>
            </form>
        </section>

        <section class="lightious-section" id="phones" aria-labelledby="phones-title">
            <header class="lightious-section-header">
                <div>
                    <p class="lightious-section-label">Phones</p>
                    <h2 id="phones-title">Connected devices</h2>
                </div>
                <a class="lightious-action" href="/lightious/pair">Pair a phone</a>
            </header>
            <p class="lightious-section-copy">Each phone receives its own credential, so you can revoke one without affecting the others.</p>

            <% if devices.empty? %>
                <p class="lightious-empty">No phones are paired. Start pairing in Lightious settings, then enter the code here.</p>
            <% else %>
                <div class="lightious-list">
                    <% devices.each do |device| %>
                        <article class="lightious-list-row">
                            <div>
                                <h3><%= HTML.escape(device.label) %></h3>
                                <p>
                                    <% if device.revoked_at %>
                                        Access revoked
                                    <% elsif device.last_seen_at %>
                                        Last synced <%= device.last_seen_at.not_nil!.to_s("%Y-%m-%d %H:%M UTC") %>
                                    <% else %>
                                        Paired · waiting for first sync
                                    <% end %>
                                </p>
                            </div>
                            <% unless device.revoked_at %>
                                <form action="/lightious/devices/<%= device.id %>/revoke" method="post">
                                    <input type="hidden" name="csrf_token" value="<%= HTML.escape(csrf_token) %>">
                                    <button class="lightious-action lightious-action-secondary" type="submit" aria-label="Revoke <%= HTML.escape(device.label) %>">Revoke phone</button>
                                </form>
                            <% end %>
                        </article>
                    <% end %>
                </div>
            <% end %>
        </section>
    </div>
</div>
